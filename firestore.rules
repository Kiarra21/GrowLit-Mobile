rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow reading/writing `status` and `history` used by the app.
    // For development/testing we keep these open; lock down rules
    // before shipping to production (require `request.auth != null`).
    match /status/{doc} {
      allow read, write: if true;
    }

    match /history/{doc} {
      allow read, write: if true;
    }

    // Keep `users` more restrictive by default
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}